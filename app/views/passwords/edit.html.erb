<main class="auth-shell">
  <section class="auth-card">
    <p class="eyebrow">PDI · crescimento com intenção</p>
    <h1>Escolha sua nova senha.</h1>
    <% if flash[:alert] %><p class="form-alert" role="alert"><%= flash[:alert] %></p><% end %>
    <%= form_with url: password_path(params[:token]), method: :put do |form| %>
      <%= form.label :password, "Nova senha" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
      <%= form.label :password_confirmation, "Confirme a nova senha" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
      <%= form.submit "Salvar nova senha", class: "button button-primary button-full" %>
    <% end %>
    <p class="auth-switch"><%= link_to "Voltar para entrar", new_session_path %></p>
  </section>
</main>
